{
  "name": "estateflow-app",
  "private": true,
  "version": "2.0.0",
  "description": "EstateFlow mobile app (Capacitor 8, Android first) for field staff and customers. Talks to estateflow-backend.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "android": "node scripts/emulator.mjs run",
    "emulator:doctor": "node scripts/emulator.mjs doctor",
    "emulator:avd": "node scripts/emulator.mjs avd",
    "emulator:run": "node scripts/emulator.mjs run",
    "emulator:live": "node scripts/emulator.mjs live",
    "build:android": "node scripts/emulator.mjs bundle",
    "build:release": "node scripts/emulator.mjs release",
    "build:bundle": "node scripts/emulator.mjs release --aab",
    "android:sync": "npm run build && node --experimental-strip-types node_modules/@capacitor/cli/bin/capacitor sync android",
    "android:open": "node --experimental-strip-types node_modules/@capacitor/cli/bin/capacitor open android",
    "android:apk": "npm run android:sync && node scripts/gradle.mjs assembleDebug",
    "android:release": "npm run android:sync && node scripts/gradle.mjs assembleRelease",
    "android:bundle": "npm run android:sync && node scripts/gradle.mjs bundleRelease"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "8.0.1",
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/camera": "8.2.6",
    "@capacitor/core": "8.5.2",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/geolocation": "8.2.4",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/network": "8.0.1",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "@capgo/capacitor-native-biometric": "8.7.0",
    "@estateflow/shared": "file:./shared",
    "@estateflow/site": "file:./site",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@tanstack/query-async-storage-persister": "5.104.3",
    "@tanstack/react-query": "5.104.3",
    "@tanstack/react-query-persist-client": "5.104.3",
    "clsx": "2.1.1",
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "sonner": "2.0.8"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.22"
  }
}
